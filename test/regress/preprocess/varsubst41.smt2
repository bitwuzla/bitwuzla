(set-logic QF_BV)
(set-option :incremental true)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(declare-const z (_ BitVec 4))
(declare-const w (_ BitVec 4))
(assert (bvult x #x3))
(set-info :status sat)
(check-sat)
(push 1)
(assert (= z (bvadd y #x1)))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (= x (bvadd y #x8)))
(assert (bvult y #x2))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (bvult w #x3))
(set-info :status sat)
(check-sat)
(assert (= z (bvadd y #x1)))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (bvult w #x4))
(set-info :status sat)
(check-sat)
(assert (= z (bvadd y #x1)))
(set-info :status sat)
(check-sat)
(assert (= w (bvadd y #x8)))
(assert (bvult y #x2))
(set-info :status unsat)
(check-sat)
(pop 1)
