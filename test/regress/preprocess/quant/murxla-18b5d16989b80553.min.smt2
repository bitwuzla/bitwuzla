(set-logic UF)
(declare-fun f (Bool) Bool)
(declare-fun g (Bool) Bool)
(declare-const c Bool)
(assert (f c))
(define-fun q () Bool (forall ((x Bool) (z Bool) (w Bool)) (g (= x z (and (f c) (g false))))))
(set-info :status sat)
(check-sat)
(assert (= c (not (g q))))
(set-info :status sat)
(check-sat)
(assert (not (g (distinct false (g q)))))
(set-info :status sat)
(check-sat)
