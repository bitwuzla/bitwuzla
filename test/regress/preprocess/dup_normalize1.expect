(set-logic QF_BV)
(declare-const a (_ BitVec 8))
(declare-const b (_ BitVec 8))
(declare-const c (_ BitVec 8))
(define-const @def0 (_ BitVec 8) (bvadd b c))
(define-const @def1 Bool (bvult (bvmul a @def0) (bvadd #b00000001 (bvnot (bvmul a (bvnot @def0))))))
(push 1)
(assert @def1)
(push 1)
(assert @def1)
(check-sat)
(exit)
