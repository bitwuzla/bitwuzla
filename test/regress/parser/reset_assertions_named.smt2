(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :global-declarations true)
(set-logic QF_BV)
(declare-const a Bool)
(assert (! a :named n))
(check-sat)
(reset-assertions)
; the assertion named n is removed, the declarations of a and n remain
(get-value (a))
(assert (not a))
(assert n)
(check-sat)
(get-unsat-core)
