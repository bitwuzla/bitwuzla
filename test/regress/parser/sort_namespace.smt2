(set-logic UFBV)
(set-option :produce-models true)
; sorts and terms have separate namespaces
(declare-sort U 0)
(declare-fun U () U)
(declare-fun V () U)
(declare-fun f (U) Bool)
(declare-fun g () Bool)
(declare-sort g 0)
(declare-fun h (g) Bool)
(define-sort W () (_ BitVec 4))
(declare-const W W)
(assert (forall ((W W)) (= (bvand W #x0) #x0)))
(assert (and (f U) (not (f V)) g (= W #x3)))
; quoted simple symbols are the same sort symbol as their unquoted version
(declare-sort |S| 0)
(declare-fun s () S)
(push 1)
(declare-sort X 0)
(declare-fun X () Bool)
(pop 1)
; the term X is popped with the sort X
(declare-fun X () W)
(assert (= X (bvadd W #x1)))
(check-sat)
(get-value (W X g (f U) (f V)))
