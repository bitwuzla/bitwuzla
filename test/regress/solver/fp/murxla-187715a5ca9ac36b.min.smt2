(set-logic QF_ABVFP)
(set-option :produce-unsat-assumptions true)
(declare-const r RoundingMode)
(declare-const a (Array Bool Bool))
(declare-const x (_ BitVec 128))
(define-fun f () Float32 ((_ to_fp 8 24) r x))
(assert (select a (= (fp.isZero f) (fp.isZero f))))
(set-info :status unsat)
(check-sat-assuming ((fp.isSubnormal f)))
(set-info :status sat)
(check-sat)
