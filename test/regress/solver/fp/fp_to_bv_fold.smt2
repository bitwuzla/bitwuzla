(set-logic QF_BVFP)
(declare-const x Float32)
(declare-const r RoundingMode)
(define-fun half () Float32 ((_ to_fp 8 24) RNE 0.5))
(define-fun two_half () Float32 ((_ to_fp 8 24) RNE 2.5))
(define-fun c128 () Float32 ((_ to_fp 8 24) RNE 128.0))
(define-fun c256 () Float32 ((_ to_fp 8 24) RNE 256.0))
; Constant folding agrees with the word-blasted encoding of symbolic terms.
(push 1)
(assert (fp.eq x two_half))
(assert (= r RNA))
(assert (or (distinct ((_ fp.to_ubv 8) r x) ((_ fp.to_ubv 8) RNA two_half))
            (distinct ((_ fp.to_sbv 8) r (fp.neg x))
                      ((_ fp.to_sbv 8) RNA (fp.neg two_half)))
            (distinct ((_ fp.to_ubv 8) RNE x) ((_ fp.to_ubv 8) RNE two_half))
            (distinct ((_ fp.to_sbv 8) RTN (fp.neg x))
                      ((_ fp.to_sbv 8) RTN (fp.neg two_half)))))
(set-info :status unsat)
(check-sat)
(pop 1)
; Negative values that round to zero are in the range of fp.to_ubv.
(push 1)
(assert (fp.eq x (fp.neg half)))
(assert (or (distinct ((_ fp.to_ubv 8) RTZ (fp.neg half)) #x00)
            (distinct ((_ fp.to_ubv 8) RTZ x) #x00)))
(set-info :status unsat)
(check-sat)
(pop 1)
; The result for NaN, infinity and values out of range is unspecified, and
; chosen independently for each rounding mode and operand value.
(push 1)
(assert (= ((_ fp.to_ubv 8) RNE (_ NaN 8 24)) #x00))
(assert (= ((_ fp.to_ubv 8) RTZ (_ NaN 8 24)) #x01))
(assert (= ((_ fp.to_ubv 8) RNE (_ +oo 8 24)) #x02))
(assert (= ((_ fp.to_ubv 8) RNE c256) #x03))
(assert (= ((_ fp.to_ubv 8) RNE (fp.neg half)) #x00))
(assert (= ((_ fp.to_ubv 8) RNA (fp.neg half)) #x04))
(assert (= ((_ fp.to_sbv 8) RNE c128) #x05))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (= ((_ fp.to_ubv 8) RNE (_ NaN 8 24)) #xff))
(assert (= ((_ fp.to_ubv 8) RTZ (_ NaN 8 24)) #xff))
(assert (= ((_ fp.to_ubv 8) RNE (_ +oo 8 24)) #xff))
(assert (= ((_ fp.to_ubv 8) RNE c256) #xff))
(assert (= ((_ fp.to_ubv 8) RNA (fp.neg half)) #xff))
(assert (= ((_ fp.to_sbv 8) RNE c128) #xff))
(set-info :status sat)
(check-sat)
(pop 1)
; The unspecified result is the same for all applications on the same values.
(push 1)
(assert (= r RNE))
(assert
  (or (and (fp.isNaN x)
           (distinct ((_ fp.to_ubv 8) r x) ((_ fp.to_ubv 8) RNE (_ NaN 8 24))))
      (and (fp.eq x c256)
           (distinct ((_ fp.to_sbv 8) r x) ((_ fp.to_sbv 8) RNE c256)))))
(set-info :status unsat)
(check-sat)
(pop 1)
