(set-logic QF_FP)
(declare-const a (_ FloatingPoint 3 4))
(assert (fp.lt (fp #b0 #b100 #b000) a))
(assert (fp.lt a (fp #b0 #b100 #b100)))
(assert (fp.eq (fp.roundToIntegral RNE a) (fp #b0 #b100 #b000)))
(push 1)
(set-info :status sat)
(check-sat)
(pop 1)
(assert (fp.gt a (fp #b0 #b100 #b010)))
(set-info :status unsat)
(check-sat)
