(set-logic QF_FP)
(declare-const x Float32)
(declare-const y Float32)
(define-fun one () Float32 ((_ to_fp 8 24) RNE 1.0))
(define-fun two () Float32 ((_ to_fp 8 24) RNE 2.0))
; Constant folding agrees with the word-blasted encoding of symbolic terms.
(push 1)
(assert (fp.eq x one))
(assert (fp.eq y two))
(assert (or (distinct (fp.min x y) (fp.min one two))
            (distinct (fp.max x y) (fp.max one two))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (fp.isNaN x))
(assert (or (distinct (fp.min x one) (fp.min (_ NaN 8 24) one))
            (distinct (fp.max one x) (fp.max one (_ NaN 8 24)))))
(set-info :status unsat)
(check-sat)
(pop 1)
; The result for zeros of different sign is unspecified, and chosen
; independently for fp.min and fp.max and each order of the operands.
(push 1)
(assert (= (fp.min (_ +zero 8 24) (_ -zero 8 24)) (_ +zero 8 24)))
(assert (= (fp.min (_ -zero 8 24) (_ +zero 8 24)) (_ +zero 8 24)))
(assert (= (fp.max (_ +zero 8 24) (_ -zero 8 24)) (_ -zero 8 24)))
(assert (= (fp.max (_ -zero 8 24) (_ +zero 8 24)) (_ -zero 8 24)))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (= (fp.min (_ +zero 8 24) (_ -zero 8 24)) (_ -zero 8 24)))
(assert (= (fp.min (_ -zero 8 24) (_ +zero 8 24)) (_ +zero 8 24)))
(assert (= (fp.max (_ +zero 8 24) (_ -zero 8 24)) (_ +zero 8 24)))
(assert (= (fp.max (_ -zero 8 24) (_ +zero 8 24)) (_ -zero 8 24)))
(set-info :status sat)
(check-sat)
(pop 1)
; The unspecified result is the same for all applications on the same values.
(push 1)
(assert (fp.isZero x))
(assert (fp.isPositive x))
(assert (fp.isZero y))
(assert (fp.isNegative y))
(assert (or (distinct (fp.min x y) (fp.min (_ +zero 8 24) (_ -zero 8 24)))
            (distinct (fp.max y x) (fp.max (_ -zero 8 24) (_ +zero 8 24)))))
(set-info :status unsat)
(check-sat)
(pop 1)
