; Unsupported equalities in assertions answer unknown on every check-sat in
; their scope, and no longer after the scope is popped.
(set-logic ALL)
(declare-sort U 0)
(declare-const a U)
(declare-const b U)
(declare-const p Bool)
(declare-fun f (U) Bool)
(declare-fun h (U) Bool)
(assert (or p (f a)))
(push 1)
(assert (xor p (= a b)))
(check-sat)
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (xor p (= f h)))
(check-sat)
(check-sat)
(pop 1)
(check-sat)
