(set-logic BV)
(set-info :status unsat)
(set-option :quant-ic true)
(set-option :quant-ic-underdet false)
(declare-const a (_ BitVec 32))
(assert (= ((_ extract 0 0) a) #b1))
(assert (forall ((x (_ BitVec 32))) (distinct (bvmul ((_ extract 15 0) x) ((_ extract 15 0) a)) #x0006)))
(check-sat)
(exit)
