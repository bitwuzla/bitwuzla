(set-logic BVFP)
(declare-const c (_ BitVec 8))
(declare-const d (_ BitVec 8))
(declare-const a Float16)
(declare-const b Float16)
(assert (fp.eq a (fp #b0 #b10000 #b0000000000)))
(assert (fp.eq b (fp #b0 #b10001 #b0000000000)))
(assert (= d #x09))
(assert (= c ((_ fp.to_ubv 8) RNE (ite (forall ((y (_ BitVec 8))) (distinct (bvmul y y) d)) a b))))
(assert (= c #x02))
(set-info :status unsat)
(check-sat)
