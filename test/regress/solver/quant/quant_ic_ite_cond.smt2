(set-logic BV)
(set-info :status unsat)
(set-option :quant-ic true)
(declare-const a (_ BitVec 32))
(declare-const b (_ BitVec 32))
(declare-const d (_ BitVec 32))
(declare-const t (_ BitVec 32))
(assert (or (= b t) (= d t)))
(assert (= ((_ extract 0 0) a) #b1))
(assert (forall ((x (_ BitVec 32))) (distinct (ite (= (bvmul x a) #x00000006) b d) t)))
(check-sat)
(exit)
