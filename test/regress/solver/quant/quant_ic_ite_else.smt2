(set-logic BV)
(set-info :status unsat)
(set-option :quant-ic true)
(declare-const a (_ BitVec 32))
(declare-const c Bool)
(assert (or (not c) (= a #x00000006)))
(assert (= ((_ extract 0 0) a) #b1))
(assert (forall ((x (_ BitVec 32))) (distinct (ite c a (bvmul x a)) #x00000006)))
(check-sat)
(exit)
