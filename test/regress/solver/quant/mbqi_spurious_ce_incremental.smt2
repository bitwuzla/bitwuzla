(set-logic BVFP)
(set-option :incremental true)
(declare-const c (_ BitVec 8))
(push 1)
(assert (forall ((x Float16)) (=> (fp.isNaN x) (= ((_ fp.to_ubv 8) RNE x) c))))
(set-info :status sat)
(check-sat)
(assert (distinct c ((_ fp.to_ubv 8) RNE (_ NaN 5 11))))
(set-info :status unsat)
(check-sat)
(pop 1)
(assert (forall ((x Float16) (y (_ BitVec 8))) (=> (fp.isNaN x) (= ((_ fp.to_sbv 8) RNE x) y))))
(set-info :status unsat)
(check-sat)
