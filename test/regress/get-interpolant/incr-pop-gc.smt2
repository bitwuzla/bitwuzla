; ignore output
; Clauses of popped assertion levels are garbage collected from the proof
; tracer. Exercises learned clauses at levels > 0, nested and multi-level pops,
; empty levels, and re-pushing a level (with a fresh activation literal) after
; it was popped. Interpolants are checked after each pop.
(set-logic QF_BV)
(set-option :produce-interpolants true)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(declare-const z (_ BitVec 8))
(assert (! (= (bvmul ((_ zero_extend 8) x) ((_ zero_extend 8) y)) (_ bv143 16)) :named a0))
(push 1)
(assert (! (and (distinct x (_ bv1 8)) (distinct y (_ bv1 8))) :named a1))
(push 1)
(assert (! (and (distinct x (_ bv11 8)) (distinct x (_ bv13 8))) :named a2))
(set-info :status unsat)
(check-sat)
(get-interpolant (a0 a1))
(pop 1)
(set-info :status sat)
(check-sat)
(push 1)
(push 1)
(assert (! (= z (bvadd x y)) :named a3))
(assert (! (distinct z (_ bv24 8)) :named a4))
(set-info :status unsat)
(check-sat)
(get-interpolant (a0 a3))
(pop 2)
(push 1)
(assert (! (bvult x (_ bv11 8)) :named a5))
(set-info :status unsat)
(check-sat)
(get-interpolant (a0))
(pop 1)
(push 1)
(pop 1)
(pop 1)
(assert (! (= x (_ bv1 8)) :named a6))
(assert (! (distinct y (_ bv143 8)) :named a7))
(set-info :status unsat)
(check-sat)
(get-interpolant (a0 a6))
