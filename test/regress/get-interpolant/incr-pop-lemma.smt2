; ignore output
; Abstraction lemmas generated by the first check-sat inside the pushed level
; are encoded at the level of their terms (0), thus their clauses survive the
; pop, while the lemmas are dropped from the (backtrackable) lemma cache. The
; second check-sat is unsat due to these lemma clauses, which thus must be
; labeled for interpolation.
(set-option :produce-interpolants true)
(declare-const t (_ BitVec 1))
(assert (= (_ bv0 32) ((_ extract 38 7) (bvadd (bvmul (_ bv3 39) ((_ zero_extend 38) t)) (concat (_ bv1 31) (_ bv0 1) (_ bv0 1) (_ bv0 1) (_ bv0 1) (_ bv0 1) (_ bv0 1) (_ bv0 2))))))
(push 1)
(set-info :status unsat)
(check-sat)
(pop 1)
(assert (! true :named a))
(set-info :status unsat)
(check-sat)
(get-interpolants (a))
